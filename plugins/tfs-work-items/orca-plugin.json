{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "tfs-work-items",
  "publisher": "manmonths",
  "name": "Azure DevOps",
  "version": "1.2.9",
  "description": "人月維護的 Azure DevOps / 地端 TFS 工項互動面板，支援使用 PAT 查詢、新增（Task / Bug）、更新狀態、留言與一鍵派工給 Orca Agent。",
  "author": {
    "name": "人月",
    "url": "https://github.com/fuevaco"
  },
  "repository": "https://github.com/fuevaco/manmonths",
  "engines": {
    "orca": ">=1.4.259"
  },
  "pluginApi": 1,
  "main": "worker/index.mjs",
  "contributes": {
    "panels": [
      {
        "id": "tfs-work-items",
        "title": "Azure DevOps",
        "icon": "blocks",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "settings": [
      {
        "key": "tfsUrl",
        "title": "Azure DevOps / TFS Collection 網址",
        "description": "Azure DevOps Server 或地端 TFS 的 Collection URL（例如：https://tfs.company.com/tfs/DefaultCollection）。",
        "type": "string",
        "default": "",
        "placeholder": "https://tfs.company.com/tfs/DefaultCollection"
      },
      {
        "key": "project",
        "title": "預設專案名稱 (選填)",
        "description": "選填；若留空則預設查詢整個 Collection 的所有專案工項，並可在面板內依專案分類篩選。",
        "type": "string",
        "default": "",
        "placeholder": "留空代表全部專案"
      },
      {
        "key": "apiVersion",
        "title": "REST API 版本",
        "description": "依 Azure DevOps Server / TFS 版本選擇（2018u2+ 建議 5.0；2020+ 建議 6.0；2022+ 建議 7.0）。",
        "type": "string",
        "default": "5.0",
        "enum": ["4.1", "5.0", "6.0", "7.0"],
        "enumLabels": [
          "4.1 (TFS 2018)",
          "5.0 (TFS 2018 Update 2 / Server 2019)",
          "6.0 (Azure DevOps Server 2020)",
          "7.0 (Azure DevOps Server 2022+)"
        ]
      },
      {
        "key": "authMode",
        "title": "認證方式",
        "description": "PAT：使用個人存取權杖。Windows：使用這台電腦目前登入的網域帳號（Kerberos，僅限 Windows，網址須用網域名稱）；失敗時若已設定 PAT 會自動改用 PAT。",
        "type": "string",
        "default": "pat",
        "enum": ["pat", "windows"],
        "enumLabels": ["PAT（個人存取權杖）", "Windows 整合驗證"]
      },
      {
        "key": "allowInsecureTls",
        "title": "允許內網自簽 HTTPS 憑證",
        "description": "若公司地端 TFS 使用自簽或未受系統信任的 SSL 憑證，請開啟此選項。",
        "type": "boolean",
        "default": false
      },
      {
        "key": "defaultAgent",
        "title": "一鍵派工預設 Agent",
        "description": "從工項點擊「傳送到聊天視窗」時開啟的預設 Coding Agent（例如 claude、codex）。",
        "type": "string",
        "default": "claude",
        "placeholder": "claude"
      }
    ]
  },
  "capabilities": [
    { "kind": "settings:own" },
    { "kind": "secrets:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:read" },
    { "kind": "agent:launch" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ]
}
